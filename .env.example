# Telegram API credentials: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Web UI. Keep 127.0.0.1: the UI has NO login. HOST=0.0.0.0 exposes full control of your Telegram account to your network.
HOST=127.0.0.1
PORT=8000

# Ollama (initial defaults; URL/model can then be changed in the admin UI and are kept in data/store.json)
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b-cloud
# Required for Ollama Cloud (https://ollama.com/settings/keys). Leave empty for a local Ollama.
OLLAMA_API_KEY=

# Recent messages kept per private conversation (initial default; editable in the UI)
HISTORY_LIMIT=6

DATA_FILE=data/store.json
LOG_FILE=data/log.json
SESSIONS_DIR=sessions